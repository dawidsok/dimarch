general {
    output_format = "i3bar"
    colors = false
    interval = 5
}
order += "wireless _first_"
order += "ethernet _first_"
order += "tztime local"
wireless _first_ {
    format_up = "wifi %essid"
    format_down = ""
}
ethernet _first_ {
    format_up = "eth %ip"
    format_down = ""
}
tztime local {
    format = "%Y-%m-%d %H:%M"
}
